  flex: 1;
  background-color: #000;
  flex-direction: column;
}

.content {
  padding: 20px;
  flex-direction: column;
}

.header {
  margin-bottom: 20px;
}

.title {
  font-size: 42px;
  color: #fff;
  font-weight: 700;
}

.card {
  margin-top: 16px;
  padding: 22px;
  background-color: rgba(255,255,255,0.06);
  border-radius: 24px;
  flex-direction: column;
}

.label {
  font-size: 26px;
  color: rgba(255,255,255,0.7);
  margin-bottom: 18px;
}

.row {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.value {
  font-size: 38px;
  color: #fff;
  font-weight: 600;
}

.circleBtn {
  width: 64px;
  height: 64px;
  border-radius: 32px;
  background-color: #2f6fff;
  justify-content: center;
  align-items: center;
}

.btnText {
  font-size: 34px;
  color: #fff;
  font-weight: 700;
}

/* switch */
.switchWrap {
  width: 113px;
  height: 80px;
  justify-content: center;
  align-items: center;
}

.switchImg {
  width: 113px;
  height: 80px;
}

/* spacer */
.spacer {
  flex: 1;
}

/* reset */
.resetCard {
  margin-top: 18px;
  padding: 22px;
  background-color: rgba(255,77,77,0.12);
  border-radius: 24px;
  justify-content: center;
  align-items: center;
}

.resetTitle {
  font-size: 32px;
  color: #ff4d4d;
  font-weight: 700;
}

.resetSub {
  font-size: 22px;
  color: rgba(255,255,255,0.5);
  margin-top: 6px;
}

/* bottom */
.bottomBar {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 20px;
}

.iconBtn {
  width: 113px;
  height: 80px;
  justify-content: center;
  align-items: center;
}

.icon {
  width: 113px;
  height: 80px;
}
</style>