<template>
  <div class="page">

    <div class="content">

      <div class="header">
        <text class="title">设置</text>
      </div>

      <!-- 专注时间 -->
      <div class="card">
        <text class="label">专注时长</text>

        <div class="row">
          <div class="circleBtn" @click="minusFocus">
            <text class="btnText">-</text>
          </div>

          <text class="value">{{focusTime}} min</text>

          <div class="circleBtn" @click="addFocus">
            <text class="btnText">+</text>
          </div>
        </div>
      </div>

      <!-- 休息时间 -->
      <div class="card">
        <text class="label">休息时长</text>

        <div class="row">
          <div class="circleBtn" @click="minusBreak">
            <text class="btnText">-</text>
          </div>

          <text class="value">{{breakTime}} min</text>

          <div class="circleBtn" @click="addBreak">
            <text class="btnText">+</text>
          </div>
        </div>
      </div>

      <!-- 震动提醒 -->
      <div class="card">
        <text class="label">震动提醒</text>

        <div class="row">

          <text class="value">{{vibrateOn ? "开启" : "关闭"}}</text>

          <div class="switchWrap" @click="toggleVibrate">
            <image class="switchImg"
              src="{{vibrateOn ? '/common/icon/Switch_ON.png' : '/common/icon/Switch_OFF.png'}}" />
          </div>

        </div>
      </div>

      <!-- 震动时长（秒） -->
      <div class="card">
        <text class="label">震动时长</text>

        <div class="row">

          <div class="circleBtn" @click="minusVibrate">
            <text class="btnText">-</text>
          </div>

          <text class="value">{{vibrateDuration}} s</text>

          <div class="circleBtn" @click="addVibrate">
            <text class="btnText">+</text>
          </div>

        </div>
      </div>

      <!-- spacer -->
      <div class="spacer"></div>

      <!-- 恢复默认 -->
      <div class="resetCard" @click="resetDefault">
        <text class="resetTitle">恢复默认设置</text>
      </div>

    </div>

    <!-- bottom bar -->
    <div class="bottomBar">

      <div class="iconBtn" @click="goBack">
        <image class="icon" src="/common/icon/back.png" />
      </div>

      <div class="iconBtn" @click="saveAndExit">
        <image class="icon" src="/common/icon/conform.png" />
      </div>

    </div>

  </div>
</template>

<script>
import storage from '@system.storage'
import router from '@system.router'

export default {

  private: {
    focusTime: 25,
    breakTime: 5,

    vibrateOn: true,
    vibrateDuration: 1
  },

  onInit() {
    this.load()
  },

  load() {

    storage.get({
      key: "focusTime",
      success: (data) => {
        if (data) this.focusTime = Math.floor(parseInt(data) / 60)
      }
    })

    storage.get({
      key: "breakTime",
      success: (data) => {
        if (data) this.breakTime = Math.floor(parseInt(data) / 60)
      }
    })

    storage.get({
      key: "vibrateOn",
      success: (data) => {
        if (data !== undefined) {
          this.vibrateOn = data === "true"
        }
      }
    })

    storage.get({
      key: "vibrateDuration",
      success: (data) => {
        if (data) this.vibrateDuration = parseInt(data)
      }
    })
  },

  minusFocus() { if (this.focusTime > 1) this.focusTime-- },
  addFocus() { this.focusTime++ },

  minusBreak() { if (this.breakTime > 1) this.breakTime-- },
  addBreak() { this.breakTime++ },

  toggleVibrate() {
    this.vibrateOn = !this.vibrateOn
  },

  minusVibrate() {
    if (this.vibrateDuration > 1) this.vibrateDuration--
  },

  addVibrate() {
    if (this.vibrateDuration < 10) this.vibrateDuration++
  },

  resetDefault() {
    this.focusTime = 25
    this.breakTime = 5
    this.vibrateOn = true
    this.vibrateDuration = 1
  },

  goBack() {
    router.back()
  },

  saveAndExit() {

    storage.set({
      key: "focusTime",
      value: String(this.focusTime * 60)
    })

    storage.set({
      key: "breakTime",
      value: String(this.breakTime * 60)
    })

    storage.set({
      key: "vibrateOn",
      value: String(this.vibrateOn)
    })

    storage.set({
      key: "vibrateDuration",
      value: String(this.vibrateDuration)
    })

    router.back()
  }
}
</script>

